# GEMINI_API_KEY: Required for Gemini AI API calls and Speech-to-Text transcription.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens (JWT) for Patient and Doctor auth.
JWT_SECRET="your-jwt-secret-key-change-in-production"

# ENCRYPTION_KEY: 256-bit symmetric encryption key used for AES-256-GCM encryption at rest of patient health and contact data.
ENCRYPTION_KEY="your-256-bit-encryption-key-for-data-at-rest"

# DATABASE_URL: Persistent database connection URI (defaults to embedded SQLite database in ./data/qdiagnose.db)
DATABASE_URL="sqlite://data/qdiagnose.db"

# STT_TTS_API_KEY: Optional external provider key for Speech-to-Text and Text-to-Speech synthesis voices.
STT_TTS_API_KEY="your-stt-tts-provider-api-key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ML_API_URL: Optional external Machine Learning / Qiskit quantum backend service endpoint.
ML_API_URL="https://api.example.com/ml"

# PORT: Server listener port (Container reverse proxy routes traffic on 3000)
PORT=3000

